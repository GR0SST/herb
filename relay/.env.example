HOST=127.0.0.1
PORT=8790
HERB_DATA_DIR=./data

# Your public address, no trailing slash. Turns on browser sign-in for agents.
HERB_PUBLIC_URL=https://herb.example.com
# Anyone can create an account. Set to false to create accounts only with the CLI.
HERB_OPEN_REGISTRATION=true

# VoIP push. Without it calls ring only while the app is open.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.example.herb

# Live calls run on GPT-Live. Without a key they are off.
OPENAI_API_KEY=
# GPT-Live voice, marin by default.
HERB_LIVE_VOICE=marin
# Log GPT-Live event types (no audio or text) to debug live calls.
HERB_LIVE_DEBUG=false
# Comma-separated account ids that get live calls. Empty: everyone.
HERB_LIVE_ACCOUNTS=
# Subscriptions: App Store product id = live call minutes per period.
HERB_PRODUCTS=cc.grosst.herb.live.lite=30,cc.grosst.herb.live.standard=100,cc.grosst.herb.live.pro=300
# Sandbox purchases (TestFlight, App Review) are free, so they give at most this many minutes.
HERB_SANDBOX_MINUTES=5
# Free live call minutes for every new account. Accounts are cheap, so keep this small.
HERB_FREE_MINUTES=0
# Notifications from Apple go to https://<your server>/v1/billing/apple (App Store Connect → App Information).
# With billing on, each account needs minutes (bun run cli minutes). Off: unlimited.
HERB_BILLING=false
# Let agent webhooks reach private addresses and plain http, such as a service on this machine.
HERB_ALLOW_PRIVATE_WEBHOOKS=false
