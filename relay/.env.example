HOST=127.0.0.1
PORT=8790
HERB_DATA_DIR=./data

# Your public address, no trailing slash. Turns on browser sign-in for agents.
HERB_PUBLIC_URL=https://herb.example.com
# Anyone can create an account. Set to false to create accounts only with the CLI.
HERB_OPEN_REGISTRATION=true

# VoIP push. Without it calls ring only while the app is open.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.example.herb
